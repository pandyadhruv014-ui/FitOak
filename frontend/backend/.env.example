# Database Configuration
# Get this from your Neon database dashboard
# Format: postgresql://username:password@host/database?sslmode=require
DATABASE_URL=postgresql://your_neon_user:your_password@your_neon_host.neon.tech/fitoak_db?sslmode=require

# Google Gemini AI API Key (Optional - for nutrition analysis)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Render will set this automatically)
PORT=10000
